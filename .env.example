# Copy to .env.local for local development: cp .env.example .env.local
# In Vercel set these per environment in Project → Environment Variables (redeploy after changes).
# Leaving a variable unset falls back to a safe default.

# Base URL for canonical links, Open Graph, sitemap and structured data.
# Default: https://ww-esthe.vercel.app
# Production (after launch): https://warylakesthe.pl
# NEXT_PUBLIC_SITE_URL=https://warylakesthe.pl

# Set to "true" to allow search engines to index the site.
# Default: unset (robots.txt Disallow + noindex on every page).
# Production only, after launch. Never set it for Preview.
#ALLOW_INDEXING=true

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after the visitor accepts analytics cookies.
# Default: unset (no analytics).
# Production only, after launch. Locally only for testing, as it sends data to the real GA property.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX